<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- 命令行通过 device_path:=... 和 baud_rate:=... 覆盖默认值。 -->
  <arg name="device_path" default="/dev/ttyACM0"
       description="容器内测厚仪的 USB CDC 设备路径" />
  <arg name="baud_rate" default="115200"
       description="CDC 线路编码的波特率，不是 USB 总线速率" />

  <!-- ROS 适配节点：设备打开、协议和重连由其内部 ThicknessDevice 处理。 -->
  <node pkg="thickness_usb_driver" exec="thickness_node"
        name="thickness_node" output="screen">
    <param name="device_path" value="$(var device_path)" />
    <param name="baud_rate" value="$(var baud_rate)" />
  </node>

  <!-- 处理节点：本文件仅启动进程，订阅回调的打印逻辑在 C++ 中实现。 -->
  <node pkg="measurement_manager" exec="measurement_manager_node"
        name="measurement_manager_node" output="screen" />
</launch>
